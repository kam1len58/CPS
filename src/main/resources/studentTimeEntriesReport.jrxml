<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="StudentTimeReport" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20" uuid="c6d2b3b1-8a7c-4b5a-9e3d-7c8f9a1b2c3d">
    
    <property name="com.jasperassistant.designer.GridSnap" value="false"/>
    <property name="com.jasperassistant.designer.SnapToGuides" value="true"/>
    
    <!-- Параметры отчета -->
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="generatedBy" class="java.lang.String"/>
    
    <!-- Поля данных -->
    <field name="id" class="java.lang.Long"/>
    <field name="studentName" class="java.lang.String"/>
    <field name="studentGroup" class="java.lang.String"/>
    <field name="type" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="start" class="java.lang.String"/>  <!-- НОВОЕ ПОЛЕ -->
    <field name="end" class="java.lang.String"/>    <!-- НОВОЕ ПОЛЕ -->

    <!-- Заголовок -->
    <title>
        <band height="110"> <!-- Уменьшено с 120 → 110, чтобы не выйти за границы -->
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="18" isBold="true" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Отчет по учету времени студентов]]></text>
            </staticText>
            
            <textField>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="14" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="0" y="70" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="12" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Сгенерировано: " + new java.util.Date()]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="0" y="90" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="12" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Система: " + $P{generatedBy}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <!-- Заголовки колонок -->
    <columnHeader>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="40" height="40" backcolor="#4A90E2"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="40" y="0" width="100" height="40" backcolor="#4A90E2"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Студент]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="140" y="0" width="80" height="40" backcolor="#4A90E2"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Группа]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="220" y="0" width="90" height="40" backcolor="#4A90E2"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Тип задачи]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="310" y="0" width="120" height="40" backcolor="#4A90E2"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Начало]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="430" y="0" width="125" height="40" backcolor="#4A90E2"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Окончание]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <!-- Данные -->
    <detail>
        <band height="30">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="30" backcolor="#F0F0F0" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            
            <textField>
                <reportElement x="0" y="0" width="40" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#DDDDDD"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="40" y="0" width="100" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#DDDDDD"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{studentName}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="140" y="0" width="80" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#DDDDDD"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{studentGroup}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="220" y="0" width="90" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#DDDDDD"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{type}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="310" y="0" width="120" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#DDDDDD"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{start} != null ? $F{start} : "—"]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="430" y="0" width="125" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#DDDDDD"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{end} != null ? $F{end} : "—"]]></textFieldExpression>
            </textField>
            
            <line>
                <reportElement x="0" y="29" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </graphicElement>
            </line>
        </band>
    </detail>
    
</jasperReport>